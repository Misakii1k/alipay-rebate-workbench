{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "电商运营工具箱",
  "version": "1.0.7",
  "identifier": "com.rebate.workbench",
  "build": {
    "frontendDist": "../dist-renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "电商运营工具箱",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../resources/assets/*": "assets/",
      "../resources/bin/*": "bin/"
    },
    "publisher": "rebate",
    "category": "Utility",
    "shortDescription": "电商运营工具箱",
    "longDescription": "电商运营工具箱桌面客户端，含支付宝返款、视频剪辑、收评助手、评价对比 4 个模块",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
