{
    "name":  "alipay-rebate-workbench",
    "version": "0.10.8",
    "private":  true,
    "description":  "电商运营工具箱桌面客户端",
    "main":  "dist-electron/electron/main.js",
    "scripts":  {
                    "dev":  "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:4181 \u0026\u0026 cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4181 tsc -p tsconfig.electron.json \u0026\u0026 electron .\"",
                    "web":  "vite --host 127.0.0.1 --port 4181 --strictPort",
                    "build":  "tsc -p tsconfig.json \u0026\u0026 vite build \u0026\u0026 tsc -p tsconfig.electron.json",
                    "package":  "npm run build \u0026\u0026 electron-builder --dir",
                    "dist":  "npm run build \u0026\u0026 electron-builder --win nsis",
                    "preview":  "vite preview --host 127.0.0.1",
                    "start":  "electron ."
                },
    "build":  {
                  "appId":  "com.rebate.alipay-workbench",
                  "productName":  "电商运营工具箱",
                  "electronVersion":  "33.4.11",
                  "electronDist":  "node_modules/electron/dist",
                  "files":  [
                                "dist-renderer/**/*",
                                "dist-electron/**/*",
                                "package.json"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "assets",
                                             "to":  "assets"
                                         },
                                         {
                                             "from":  "bin",
                                             "to":  "bin",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ],
                  "win":  {
                              "icon":  "build/icon.ico",
                              "signAndEditExecutable":  false,
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "publish":  [
                                  {
                                      "provider":  "generic",
                                      "url":  "https://example.com/ecommerce-toolbox/updates/"
                                  }
                              ],
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "allowElevation":  true,
                               "deleteAppDataOnUninstall":  false,
                               "perMachine":  false,
                               "createDesktopShortcut":  "always",
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "电商运营工具箱",
                               "include":  "build/installer.nsh",
                               "installerIcon":  "build/icon.ico",
                               "uninstallerIcon":  "build/icon.ico",
                               "installerHeader":  "build/installerHeader.bmp",
                               "installerSidebar":  "build/installerSidebar.bmp",
                               "uninstallerSidebar":  "build/uninstallerSidebar.bmp",
                               "installerHeaderIcon":  "build/icon.ico",
                               "displayLanguageSelector":  false,
                               "language":  "2052",
                               "warningsAsErrors":  false,
                               "artifactName":  "${productName}-${version}-Setup.${ext}",
                               "unicode":  true,
                               "differentialPackage":  true
                           }
              },
    "dependencies":  {
                         "@fontsource-variable/cormorant-garamond":  "^5.2.6",
                         "@fontsource-variable/inter":  "^5.2.8",
                         "@fontsource-variable/noto-sans-sc":  "^5.2.10",
                         "@vitejs/plugin-react":  "^4.2.1",
                         "clsx":  "^2.1.1",
                         "electron-updater":  "^6.3.9",
                         "exceljs":  "^4.4.0",
                         "lucide-react":  "^0.468.0",
                         "react":  "^18.2.0",
                         "react-dom":  "^18.2.0",
                         "vite":  "^5.0.12"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.11.5",
                            "@types/react":  "^18.2.48",
                            "@types/react-dom":  "^18.2.18",
                            "concurrently":  "^8.2.2",
                            "cross-env":  "^7.0.3",
                            "electron":  "^33.4.11",
                            "electron-builder":  "^24.13.3",
                            "png-to-ico":  "^3.0.1",
                            "sharp":  "^0.34.5",
                            "typescript":  "^5.3.3",
                            "wait-on":  "^7.2.0"
                        }
}
